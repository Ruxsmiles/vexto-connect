{
  "manifest_version": 3,
  "name": "Vexto Connect",
  "version": "0.1.0",
  "description": "把浏览器下载交给本机 Vexto",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "contextMenus",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Vexto Connect"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
